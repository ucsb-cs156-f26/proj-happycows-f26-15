# Development-only files; retain .git for the git-commit-id Maven plugin.
.devcontainer/
.devcontainer.json
.github/
docs/
issues/
plans/
**/*.md
frontend/.storybook/
frontend/src/stories/
frontend/src/tests/
frontend/src/fixtures/
frontend/src/setupTests.*
frontend/vitest.setup.*
frontend/stryker.config.*
frontend/eslint.config.*
